# ===== Public Google Sheet CSV URL (no login) =====
# Use one of these patterns for a public sheet:
# 1) Published CSV URL (often ends with output=csv)
# 2) Export URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=<GID>
SHEET_CSV_URL="https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv&gid=0"

# Column name in the CSV header
TOPIC_COLUMN_NAME="topic"

# How many Q&A per email
QA_COUNT=10

# ===== OpenAI =====
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.2"

# ===== SMTP Email =====
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS="your_app_password_or_smtp_password"

FROM_EMAIL=""
TO_EMAIL=""
